# Required: Your device fingerprint values from the Blockman GO app.
# See README.md for how to extract these from a rooted emulator.

# Your android_id (Settings.Secure.ANDROID_ID), 16 hex chars
BMG_DEVICE_ID=

# The "bmg-sign" value from the app's SharedPreferences/MMKV (key: "bm_ddh_id")
# On rooted emulator: strings /data/data/com.sandboxol.blockymods/files/mmkv/bmg_cache | grep bm_ddh_id
BMG_BMDDH_ID=

# Optional: device signature from the device pool (defaults to BMG_BMDDH_ID if empty)
BMG_DEVICE_SIGN=

# Optional: override API endpoints
# BMG_API_BASE=https://gw.sandboxol.com
# BMG_TIME_API=http://di.sandboxol.com/api/server-time
# BMG_DEVICE_POOL_URL=https://pastebin.com/raw/m4EZm0z5
