# Required: values from the same Blockman GO app installation.
# See README.md for extraction instructions.

# Settings.Secure.ANDROID_ID from the emulator, normally 16 hex characters.
BMG_DEVICE_ID=

# The exact bm_ddh_id value stored by Blockman GO in its MMKV data.
# This is not derived from BMG_DEVICE_ID and cannot be generated by the wrapper.
BMG_BMDDH_ID=

# Optional: a separate device-pool signature. Leave empty for direct emulator data.
BMG_DEVICE_SIGN=

# Optional endpoint overrides.
# BMG_API_BASE=https://gw.sandboxol.com
# BMG_TIME_API=http://di.sandboxol.com/api/server-time
# BMG_DEVICE_POOL_URL=https://pastebin.com/raw/m4EZm0z5
